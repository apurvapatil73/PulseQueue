# ==============================================================================
# PulseQueue Environment Configuration Template
# Copy this file to `.env` before starting the platform for local development.
# DO NOT commit `.env`, real secrets, or production credentials to version control.
#
# Consumed by:
#   - Backend & Worker (`apps/backend/src/config/env.ts`, imported by `@pulsequeue/worker`)
#   - Prisma CLI (`apps/backend/prisma/schema.prisma`)
#   - Docker Compose (`docker-compose.yml`)
#   - Frontend Vite build (`apps/frontend/src/config/env.ts`)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Process Identity (Backend & Worker)
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'production' | 'test' (default: 'development')
NODE_ENV=development

# Backend HTTP API port: 1-65535 (default: 3000)
PORT=3000

# Optional replica identifier for logs, heartbeats, and scheduler ownership.
# Leave unset to auto-generate `pq-<hostname>-<pid>-<random>`.
# INSTANCE_ID=api-1

# ------------------------------------------------------------------------------
# 2. Local Docker Infrastructure (`docker-compose.yml`)
# ------------------------------------------------------------------------------
# Local development defaults match `docker-compose.yml` so `docker compose up -d`
# works seamlessly before or after copying `.env.example` to `.env`.
# Replace with strong, unique credentials in staging/production.
POSTGRES_USER=pulsequeue
POSTGRES_PASSWORD=pulsequeue_dev_password
POSTGRES_DB=pulsequeue
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. PostgreSQL & Connection Pooling (Backend, Worker & Prisma)
# ------------------------------------------------------------------------------
# REQUIRED. Must match POSTGRES_* values when using local Docker Compose.
# Local host access: postgresql://<user>:<password>@localhost:5432/<db>?schema=public
DATABASE_URL=postgresql://pulsequeue:pulsequeue_dev_password@localhost:5432/pulsequeue?schema=public

# Optional Prisma connection pool size per process (1-100).
# If unset and not specified in DATABASE_URL: Prisma default in dev/test, `10` in production.
# DATABASE_POOL_SIZE=10

# Optional Prisma connection pool acquire timeout in seconds (1-120).
# DATABASE_POOL_TIMEOUT_SEC=10

# ------------------------------------------------------------------------------
# 4. Redis (Backend & Worker — BullMQ, Rate Limiting, Real-Time Pub/Sub)
# ------------------------------------------------------------------------------
# REQUIRED. Supports authentication/TLS via URL (e.g. rediss://:password@host:6379).
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. Authentication & Security (Backend & Worker)
# ------------------------------------------------------------------------------
# REQUIRED. JWT signing secret: min 16 chars in dev/test; MUST be >= 32 chars in production.
# Generate in production with: `openssl rand -hex 32`
JWT_SECRET=pulsequeue_dev_jwt_secret_replace_in_production_min_32_chars

# HMAC pepper for tenant API keys (`pq_live_...`).
# Optional in dev/test (uses a built-in dev fallback); in production MUST be explicitly set,
# >= 32 chars, and distinct from JWT_SECRET. Generate with: `openssl rand -hex 32`
API_KEY_SECRET=pulsequeue_dev_api_key_pepper_distinct_from_jwt_secret_32_chars

# JWT issuer and audience claims (defaults: 'pulsequeue-api', 'pulsequeue-client')
JWT_ISSUER=pulsequeue-api
JWT_AUDIENCE=pulsequeue-client

# ------------------------------------------------------------------------------
# 6. Reverse Proxy & CORS (Backend)
# ------------------------------------------------------------------------------
# Express `trust proxy` setting: 'false' | 'loopback' | 'linklocal' | 'uniquelocal' | 1..5
# Unrestricted 'true' is rejected by schema validation to prevent IP spoofing. (default: 'false')
TRUST_PROXY=false

# Comma-separated allowed CORS origins.
# Default in dev: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 7. Distributed Rate Limiting (Backend — Redis-backed sliding/fixed windows)
# ------------------------------------------------------------------------------
# Window duration in milliseconds: 1000-3600000 (default: 60000)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window for auth endpoints: 1-10000 (default: 20)
RATE_LIMIT_AUTH_MAX=20

# Max requests per window for state-mutating API routes: 1-100000 (default: 300)
RATE_LIMIT_WRITE_MAX=300

# Max requests per window for DLQ replay routes: 1-10000 (default: 60)
RATE_LIMIT_DLQ_REPLAY_MAX=60

# Max requests per window for general API routes: 1-100000 (default: 600)
RATE_LIMIT_GENERAL_MAX=600

# ------------------------------------------------------------------------------
# 8. Frontend (Vite — `apps/frontend`)
# ------------------------------------------------------------------------------
# Optional backend API base URL (e.g. https://api.example.com).
# Leave empty in local development to use the Vite dev proxy.
# VITE_API_BASE_URL=
