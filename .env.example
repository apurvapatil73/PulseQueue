# ==============================================================================
# PulseQueue Environment Configuration Template
# Copy this file to .env before starting the platform for local development.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend API Service Port
PORT=3000

# PostgreSQL Configuration
POSTGRES_USER=pulsequeue
POSTGRES_PASSWORD=pulsequeue_secure_password_replace_in_prod
POSTGRES_DB=pulsequeue
POSTGRES_PORT=5432

# Database Connection URL (used by Backend / Prisma / Drizzle)
# For local host access: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public
# For docker internal network access: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
DATABASE_URL=postgresql://pulsequeue:pulsequeue_secure_password_replace_in_prod@localhost:5432/pulsequeue?schema=public

# Redis Configuration (used by BullMQ for distributed job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Authentication & Security
# Generate a secure 256-bit secret key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=pulsequeue_jwt_dev_secret_key_change_me_in_production_min_32_chars

# Worker Concurrency Settings (Optional)
WORKER_CONCURRENCY=5
