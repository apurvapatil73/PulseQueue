{
  "name": "pulsequeue",
  "version": "0.1.0",
  "description": "PulseQueue - Distributed Job Processing and Workflow Management Platform",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "npm run --workspaces --if-present clean",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "test": "npm run --workspace=@pulsequeue/backend test && npm run --workspace=@pulsequeue/worker test && npm run --workspace=@pulsequeue/frontend test",
    "test:backend": "npm run --workspace=@pulsequeue/backend test",
    "test:worker": "npm run --workspace=@pulsequeue/worker test",
    "test:frontend": "npm run --workspace=@pulsequeue/frontend test",
    "dev:backend": "npm run --workspace=@pulsequeue/backend dev",
    "dev:worker": "npm run --workspace=@pulsequeue/worker dev",
    "dev:frontend": "npm run --workspace=@pulsequeue/frontend dev",
    "build:frontend": "npm run --workspace=@pulsequeue/frontend build",
    "benchmark:scheduler": "npx tsx apps/backend/scripts/runSchedulerBenchmark.ts",
    "benchmark:performance": "npx tsx apps/backend/scripts/runPerformanceBenchmark.ts",
    "prisma:generate": "npm run --workspace=@pulsequeue/backend prisma:generate",
    "prisma:migrate": "npm run --workspace=@pulsequeue/backend prisma:migrate",
    "prisma:studio": "npm run --workspace=@pulsequeue/backend prisma:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:down:volumes": "docker compose down -v",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "dotenv": "^16.4.7",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
