datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  CANCELLED
}

enum DeadLetterStatus {
  OPEN
  REPLAYED
}

enum WorkerHealthStatus {
  ONLINE
  DEGRADED
  STALE
  STOPPED
}

enum PlatformEventType {
  JOB_SUBMITTED
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
  JOB_RETRIED
  JOB_STALLED
  JOB_RECOVERED
  JOB_MOVED_TO_DLQ
  JOB_REPLAYED
  WORKER_STARTED
  WORKER_STOPPED
  WORKER_HEARTBEAT_STALE
  ALERT_FIRED
  ALERT_ACKNOWLEDGED
  ALERT_RESOLVED
}

enum AlertType {
  QUEUE_BACKLOG
  QUEUE_WAIT_TIME
  JOB_FAILURE_RATE
  JOB_RETRY_RATE
  DLQ_COUNT
  WORKER_STALE
  JOB_LATENCY_P95
  SCHEDULE_MISFIRES
}

enum AlertComparisonOperator {
  GT
  GTE
  LT
  LTE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  FIRING
  ACKNOWLEDGED
  RESOLVED
}

enum ScheduleType {
  ONE_TIME
  RECURRING
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum MisfirePolicy {
  SKIP_MISSED
  FIRE_ONCE
  CATCH_UP
}

enum ScheduleExecutionStatus {
  SCHEDULED
  DISPATCHED
  MISSED
  SKIPPED_OVERLAP
  SKIPPED_CONCURRENCY
  SKIPPED_MIN_INTERVAL
  SKIPPED_MAX_RUNS
  CANCELLED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  memberships      Membership[]
  refreshTokens    RefreshToken[]
  sentInvitations  Invitation[]    @relation("SentInvitations")
  createdQueues    Queue[]         @relation("CreatedQueues")
  createdJobs      Job[]           @relation("CreatedJobs")
  createdSchedules Schedule[]      @relation("CreatedSchedules")
  notifications    Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Organisation {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships    Membership[]
  invitations    Invitation[]
  queues         Queue[]
  deadLetterJobs DeadLetterJob[]
  schedules      Schedule[]
  alertRules     AlertRule[]
  alerts         Alert[]
  notifications  Notification[]

  @@map("organisations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([userId])
  @@index([organisationId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  invitedEmail   String           @map("invited_email")
  role           Role             @default(MEMBER)
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  invitedById    String           @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organisationId, invitedEmail, status])
  @@index([organisationId])
  @@index([invitedEmail])
  @@index([tokenHash])
  @@map("invitations")
}

model Queue {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  name            String
  description     String?
  isPaused        Boolean   @default(false) @map("is_paused")
  pausedAt        DateTime? @map("paused_at")
  concurrency     Int       @default(5)
  defaultPriority Int       @default(5) @map("default_priority")
  maxRetries      Int       @default(3) @map("max_retries")
  backoffMs       Int       @default(1000) @map("backoff_ms")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("CreatedQueues", fields: [createdById], references: [id], onDelete: SetNull)
  jobs           Job[]
  deadLetterJobs DeadLetterJob[]
  schedules      Schedule[]
  alertRules     AlertRule[]
  alerts         Alert[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@index([organisationId, isPaused])
  @@map("queues")
}

model Job {
  id                String    @id @default(uuid()) @db.Uuid
  queueId           String    @map("queue_id") @db.Uuid
  name              String
  status            JobStatus @default(PENDING)
  priority          Int       @default(5)
  payload           Json      @default("{}") @db.JsonB
  maxRetries        Int       @default(3) @map("max_retries")
  backoffMs         Int       @default(1000) @map("backoff_ms")
  delayMs           Int       @default(0) @map("delay_ms")
  attemptsMade      Int       @default(0) @map("attempts_made")
  stalledCount      Int       @default(0) @map("stalled_count")
  durationMs        Int?      @map("duration_ms")
  lastWorkerId      String?   @map("last_worker_id")
  replayedFromDlqId String?   @map("replayed_from_dlq_id") @db.Uuid
  result            Json?     @db.JsonB
  errorMessage      String?   @map("error_message")
  firstStartedAt    DateTime? @map("first_started_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  failedAt          DateTime? @map("failed_at")
  lastRecoveredAt   DateTime? @map("last_recovered_at")
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  queue             Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)
  createdBy         User?              @relation("CreatedJobs", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchOutbox    JobDispatchOutbox?
  deadLetterRecord  DeadLetterJob?     @relation("OriginalDeadLetter")
  scheduleExecution ScheduleExecution?

  @@index([queueId])
  @@index([queueId, status, createdAt])
  @@index([queueId, completedAt])
  @@index([queueId, failedAt])
  @@index([lastWorkerId, status])
  @@index([status])
  @@index([status, startedAt])
  @@index([priority])
  @@index([createdAt])
  @@map("jobs")
}

model DeadLetterJob {
  id             String           @id @default(uuid()) @db.Uuid
  originalJobId  String           @unique @map("original_job_id") @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  queueId        String           @map("queue_id") @db.Uuid
  queueName      String           @map("queue_name")
  jobName        String           @map("job_name")
  payloadSummary Json             @default("{}") @map("payload_summary") @db.JsonB
  failureReason  String           @map("failure_reason")
  attemptsMade   Int              @map("attempts_made")
  maxRetries     Int              @map("max_retries")
  status         DeadLetterStatus @default(OPEN)
  failedAt       DateTime         @map("failed_at")
  replayedAt     DateTime?        @map("replayed_at")
  replayedById   String?          @map("replayed_by_id") @db.Uuid
  replayedJobId  String?          @unique @map("replayed_job_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  originalJob  Job          @relation("OriginalDeadLetter", fields: [originalJobId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  queue        Queue        @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([organisationId, status, createdAt])
  @@index([organisationId, queueId])
  @@map("dead_letter_jobs")
}

model WorkerHeartbeat {
  id                    String             @id @default(uuid()) @db.Uuid
  workerInstanceId      String             @unique @map("worker_instance_id")
  hostname              String
  pid                   Int
  registeredQueues      String[]           @default([]) @map("registered_queues")
  organisationIds       String[]           @default([]) @map("organisation_ids")
  status                WorkerHealthStatus @default(ONLINE)
  configuredConcurrency Int?               @map("configured_concurrency")
  cpuUsagePercent       Float?             @map("cpu_usage_percent")
  memoryRssBytes        BigInt?            @map("memory_rss_bytes")
  uptimeSeconds         Int?               @map("uptime_seconds")
  jobsProcessed         Int                @default(0) @map("jobs_processed")
  jobsSucceeded         Int                @default(0) @map("jobs_succeeded")
  jobsFailed            Int                @default(0) @map("jobs_failed")
  lastError             String?            @map("last_error")
  lastHeartbeatAt       DateTime           @default(now()) @map("last_heartbeat_at")
  startedAt             DateTime           @default(now()) @map("started_at")
  stoppedAt             DateTime?          @map("stopped_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@index([status, lastHeartbeatAt])
  @@map("worker_heartbeats")
}

model PlatformEvent {
  id             String            @id @default(uuid()) @db.Uuid
  type           PlatformEventType
  organisationId String?           @map("organisation_id") @db.Uuid
  queueId        String?           @map("queue_id") @db.Uuid
  jobId          String?           @map("job_id") @db.Uuid
  workerId       String?           @map("worker_id")
  message        String
  metadata       Json              @default("{}") @db.JsonB
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([organisationId, createdAt])
  @@index([organisationId, type, createdAt])
  @@index([jobId, createdAt])
  @@index([createdAt])
  @@map("platform_events")
}

model Schedule {
  id                String         @id @default(uuid()) @db.Uuid
  organisationId    String         @map("organisation_id") @db.Uuid
  queueId           String         @map("queue_id") @db.Uuid
  name              String
  description       String?
  type              ScheduleType
  status            ScheduleStatus @default(ACTIVE)
  jobName           String         @map("job_name")
  payload           Json           @default("{}") @db.JsonB
  priority          Int?
  maxRetries        Int?           @map("max_retries")
  backoffMs         Int?           @map("backoff_ms")
  cronExpression    String?        @map("cron_expression")
  timezone          String         @default("UTC")
  runAt             DateTime?      @map("run_at")
  nextRunAt         DateTime?      @map("next_run_at")
  lastRunAt         DateTime?      @map("last_run_at")
  lastDispatchedAt  DateTime?      @map("last_dispatched_at")
  runCount          Int            @default(0) @map("run_count")
  preventOverlap    Boolean        @default(true) @map("prevent_overlap")
  misfirePolicy     MisfirePolicy  @default(SKIP_MISSED) @map("misfire_policy")
  maxCatchUpRuns    Int            @default(5) @map("max_catch_up_runs")
  misfireGraceMs    Int            @default(60000) @map("misfire_grace_ms")
  maxConcurrentRuns Int?           @map("max_concurrent_runs")
  maxTotalRuns      Int?           @map("max_total_runs")
  maxDurationMs     Int?           @map("max_duration_ms")
  minIntervalMs     Int?           @map("min_interval_ms")
  createdById       String?        @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  queue        Queue               @relation(fields: [queueId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("CreatedSchedules", fields: [createdById], references: [id], onDelete: SetNull)
  executions   ScheduleExecution[]

  @@unique([organisationId, name])
  @@index([status, nextRunAt])
  @@index([organisationId, status])
  @@index([organisationId, queueId])
  @@map("schedules")
}

model ScheduleExecution {
  id             String                  @id @default(uuid()) @db.Uuid
  scheduleId     String                  @map("schedule_id") @db.Uuid
  jobId          String?                 @unique @map("job_id") @db.Uuid
  scheduledFor   DateTime                @map("scheduled_for")
  dispatchedAt   DateTime?               @map("dispatched_at")
  startedAt      DateTime?               @map("started_at")
  completedAt    DateTime?               @map("completed_at")
  finalJobStatus JobStatus?              @map("final_job_status")
  retryCount     Int                     @default(0) @map("retry_count")
  durationMs     Int?                    @map("duration_ms")
  isCatchUp      Boolean                 @default(false) @map("is_catch_up")
  status         ScheduleExecutionStatus @default(SCHEDULED)
  reason         String?
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  job      Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, createdAt])
  @@index([scheduleId, status, scheduledFor])
  @@index([status, createdAt])
  @@map("schedule_executions")
}

model JobDispatchOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  jobId          String       @unique @map("job_id") @db.Uuid
  queueId        String       @map("queue_id") @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  dispatchedAt   DateTime?    @map("dispatched_at")
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organisationId])
  @@map("job_dispatch_outbox")
}

model AlertRule {
  id              String                  @id @default(uuid()) @db.Uuid
  organisationId  String                  @map("organisation_id") @db.Uuid
  queueId         String?                 @map("queue_id") @db.Uuid
  name            String
  description     String?
  type            AlertType
  operator        AlertComparisonOperator @default(GT)
  threshold       Float
  windowMinutes   Int                     @default(60) @map("window_minutes")
  cooldownSeconds Int                     @default(300) @map("cooldown_seconds")
  severity        AlertSeverity           @default(WARNING)
  isEnabled       Boolean                 @default(true) @map("is_enabled")
  createdById     String?                 @map("created_by_id") @db.Uuid
  updatedById     String?                 @map("updated_by_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  queue        Queue?       @relation(fields: [queueId], references: [id], onDelete: SetNull)
  alerts       Alert[]

  @@unique([organisationId, name])
  @@index([organisationId, isEnabled])
  @@index([organisationId, queueId])
  @@map("alert_rules")
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  organisationId   String        @map("organisation_id") @db.Uuid
  ruleId           String?       @map("rule_id") @db.Uuid
  queueId          String?       @map("queue_id") @db.Uuid
  dedupKey         String        @map("dedup_key")
  ruleName         String        @map("rule_name")
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus   @default(FIRING)
  message          String
  metricValue      Float         @map("metric_value")
  threshold        Float
  occurrenceCount  Int           @default(1) @map("occurrence_count")
  firstTriggeredAt DateTime      @default(now()) @map("first_triggered_at")
  lastTriggeredAt  DateTime      @default(now()) @map("last_triggered_at")
  lastEvaluatedAt  DateTime      @default(now()) @map("last_evaluated_at")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  acknowledgedById String?       @map("acknowledged_by_id") @db.Uuid
  resolvedAt       DateTime?     @map("resolved_at")
  resolvedById     String?       @map("resolved_by_id") @db.Uuid
  resolutionReason String?       @map("resolution_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rule          AlertRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  queue         Queue?         @relation(fields: [queueId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([organisationId, status, createdAt])
  @@index([organisationId, severity, status])
  @@index([organisationId, dedupKey, status])
  @@index([ruleId, status])
  @@map("alerts")
}

model Notification {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @map("organisation_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  alertId        String?       @map("alert_id") @db.Uuid
  eventKey       String        @map("event_key")
  type           String
  severity       AlertSeverity
  title          String
  message        String
  isRead         Boolean       @default(false) @map("is_read")
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert        Alert?       @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@unique([userId, eventKey])
  @@index([organisationId, userId, isRead, createdAt])
  @@index([organisationId, userId, createdAt])
  @@map("notifications")
}
