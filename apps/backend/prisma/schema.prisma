datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JobStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
  PAUSED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  CANCELLED
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  memberships      Membership[]
  refreshTokens    RefreshToken[]
  sentInvitations  Invitation[]    @relation("SentInvitations")
  createdQueues    Queue[]         @relation("CreatedQueues")
  createdJobs      Job[]           @relation("CreatedJobs")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Organisation {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  memberships Membership[]
  invitations Invitation[]
  queues      Queue[]

  @@map("organisations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now()) @map("created_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([userId])
  @@index([organisationId])
  @@map("memberships")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @map("organisation_id") @db.Uuid
  invitedEmail   String           @map("invited_email")
  role           Role             @default(MEMBER)
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  invitedById    String           @map("invited_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organisationId, invitedEmail, status])
  @@index([organisationId])
  @@index([invitedEmail])
  @@index([tokenHash])
  @@map("invitations")
}

model Queue {
  id              String    @id @default(uuid()) @db.Uuid
  organisationId  String    @map("organisation_id") @db.Uuid
  name            String
  description     String?
  isPaused        Boolean   @default(false) @map("is_paused")
  pausedAt        DateTime? @map("paused_at")
  concurrency     Int       @default(5)
  defaultPriority Int       @default(5) @map("default_priority")
  maxRetries      Int       @default(3) @map("max_retries")
  backoffMs       Int       @default(1000) @map("backoff_ms")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CreatedQueues", fields: [createdById], references: [id], onDelete: SetNull)
  jobs         Job[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@index([organisationId, isPaused])
  @@map("queues")
}

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  queueId      String    @map("queue_id") @db.Uuid
  name         String
  status       JobStatus @default(PENDING)
  priority     Int       @default(5)
  payload      Json      @default("{}") @db.JsonB
  maxRetries   Int       @default(3) @map("max_retries")
  backoffMs    Int       @default(1000) @map("backoff_ms")
  delayMs      Int       @default(0) @map("delay_ms")
  attemptsMade Int       @default(0) @map("attempts_made")
  result       Json?     @db.JsonB
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  failedAt     DateTime? @map("failed_at")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  queue          Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)
  createdBy      User?              @relation("CreatedJobs", fields: [createdById], references: [id], onDelete: SetNull)
  dispatchOutbox JobDispatchOutbox?

  @@index([queueId])
  @@index([queueId, status, createdAt])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("jobs")
}

model JobDispatchOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  jobId          String       @unique @map("job_id") @db.Uuid
  queueId        String       @map("queue_id") @db.Uuid
  organisationId String       @map("organisation_id") @db.Uuid
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  dispatchedAt   DateTime?    @map("dispatched_at")
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organisationId])
  @@map("job_dispatch_outbox")
}
